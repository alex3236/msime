<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9（API 28）用这一份，颜色是固定的 @color/splash_glow，不跟季节。Android 9 的 GradientDrawable.applyTheme 只重读带主题属性的那几项，径向渐变的 gradientRadius 读不到就抛 XmlPullParserException，HomeActivity 一启动就崩溃；Android 10 起修好了，那里用 drawable-v29 里取 ?attr/msSplashGlow 的版本。半径的来历见那份文件。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="46%"
        android:startColor="@color/splash_glow"
        android:endColor="@android:color/transparent" />
</shape>
